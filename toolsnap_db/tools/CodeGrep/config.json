{
  "levels_up_to_root": 2,
  "file_patterns": [
    "*.py"
  ],
  "exclude_dirs": [
    "__pycache__",
    ".git",
    ".vscode",
    ".idea",
    "node_modules",
    "venv",
    ".venv",
    "env",
    ".env",
    ".tox",
    "dist",
    "build",
    "egg-info"
  ],
  "exclude_files": [
    "*.pyc",
    "*.pyo",
    "*.pyd"
  ],
  "context_lines": 2,
  "max_results": 500,
  "editor_command": "code"
}
