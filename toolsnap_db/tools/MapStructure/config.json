{
  "levels_up_to_root": 2,
  "exclude_dirs": [
    "__pycache__",
    ".git",
    ".vscode",
    ".idea",
    "node_modules",
    ".mypy_cache",
    ".pytest_cache",
    "venv",
    ".venv",
    "env",
    ".env",
    ".tox",
    "dist",
    "build",
    "egg-info"
  ],
  "exclude_suffixes": [
    ".egg-info"
  ],
  "structure_file_pattern": "^.+_STRUCTURE(_\\d{8}_\\d{6})?\\.txt$"
}
