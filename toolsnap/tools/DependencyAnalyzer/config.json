{
  "levels_up_to_root": 2,
  "archive_folder": "archive",
  "scripts_folder": "scripts",
  "output_folder": "output",
  "file_categories": {
    "scripts": [".bat", ".ps1", ".sh", ".cmd"],
    "outputs": [
      "*_STRUCTURE_*.txt",
      "*.log",
      "*_results.json",
      "*_performance*.json"
    ],
    "temp": [
      ".pyc",
      ".pyo",
      "*.pyc",
      "*.pyo",
      "__pycache__"
    ],
    "shortcuts": [".lnk"],
    "duplicates": [
      " (1).",
      " (2).",
      " (3).",
      "_old.",
      "_backup.",
      "_FIXED.",
      "_copy."
    ]
  },
  "exclude_from_analysis": [
    "__pycache__",
    ".git",
    ".vscode",
    "venv",
    ".venv",
    "node_modules",
    "archive",
    "scripts",
    "output"
  ]
}
