{
  "project_name": "TrailBoss",
  "project_root": "../..",
  "prefix": "tb_",
  "watch_dir": "~/Downloads",
  "known_root_folders": ["core", "ui", "utils", "backtest", "tools", "shared", "config", "tests"],
  "watched_extensions": [
    ".py", ".json", ".yaml", ".yml",
    ".md", ".txt", ".bat", ".ps1",
    ".zip", ".cfg", ".toml", ".ini"
  ],
  "auto_overwrite": true,
  "debounce_seconds": 1.5,
  "startup_scan": true,
  "routing_rules": [
    { "pattern": ".*\\.bat$",  "destination": "tools" },
    { "pattern": ".*\\.ps1$",  "destination": "tools" }
  ],
  "hud": {
    "enabled": true,
    "font_size": 14,
    "color": "#00FF66",
    "opacity": 0.95,
    "show_file_count": true
  }
}
